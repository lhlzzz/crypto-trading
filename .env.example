BIAN_PG_DSN=postgresql://bian:bian@localhost:5446/bian
BIAN_MODE=paper
BIAN_MARKET=FUTURES
BIAN_QUOTE_ASSET=USDT
LIVE_TRADING_ENABLED=false
# Required for live startup; never commit the real token.
# LIVE_CONFIRMATION_TOKEN=type-the-secret-token-at-startup
# Testnet and Live credentials must be separate secrets.
# BIAN_TESTNET_API_KEY=testnet-read-or-trade-key
# BIAN_TESTNET_API_SECRET=testnet-secret-not-for-commit
# BIAN_LIVE_API_KEY=live-read-or-trade-key
# BIAN_LIVE_API_SECRET=live-secret-not-for-commit
FUTURES_POSITION_MODE=ONE_WAY
FUTURES_MARGIN_MODE=ISOLATED
BIAN_MARKET_LIMIT=20
# BIAN_PYTHON_BIN=/absolute/path/to/python3.12
BIAN_HTTP_ATTEMPTS=3
BIAN_HTTP_BACKOFF_SEC=0.25
BIAN_STREAM_SYMBOLS=BTC-USDT,ETH-USDT
BIAN_STREAM_FLUSH_SEC=5
# Tier 1 scanner may remain broad; only this many symbols are escalated to
# continuous Spot/Futures positioning observation.
POSITIONING_OBSERVER_CANDIDATE_LIMIT=5
POSITIONING_OBSERVER_INTERVAL_SEC=60
# Pure evidence/decision recording only. It never invokes Risk or Execution.
POSITIONING_SHADOW_POLL_SEC=60
BIAN_MAX_DATA_AGE_SEC=900
POSITIONING_DECISION_ENABLED=false
POSITIONING_STRATEGY_VERSION=positioning-v1
ALPHA_GATE_STATUS=INSUFFICIENT_SAMPLE
# Leave unset until measured storage growth justifies an explicit raw-event TTL.
# POSITIONING_RAW_RETENTION_DAYS=7
BIAN_ENVIRONMENT=development
BIAN_RELEASE_VERSION=2026-08-15
BIAN_OPERATOR_CONTRACT_VERSION=2026-08-15
BIAN_API_HOST=0.0.0.0
BIAN_API_PORT=8001
BIAN_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
BIAN_TRUSTED_HOSTS=127.0.0.1,localhost,testserver
# BIAN_API_DOCS_ENABLED=0
BIAN_EXCHANGE_INFO_TTL_SEC=300
BIAN_BINANCE_TIMEOUT_MS=10000
BIAN_BINANCE_RETRIES=3
BIAN_BINANCE_BACKOFF_MS=250
PAPER_INITIAL_USDT=1000
PAPER_FEE_RATE=0.001
PAPER_SLIPPAGE_BPS=5
PAPER_LATENCY_MS=0
PAPER_PARTIAL_FILL_RATIO=1
PAPER_ORDER_EXPIRY_SEC=0
# Validation only; keep false and never enable in production.
TEST_ONLY_SIGNAL_INJECTION=false
TEST_ONLY_SIGNAL_SIDE=LONG
TEST_ONLY_SIGNAL_ORDER_TYPE=MARKET
TEST_ONLY_SIGNAL_QUANTITY=0.01
MAX_ORDER_USDT=100
MAX_POSITION_USDT=500
MAX_DAILY_LOSS_USDT=50
MAX_DRAWDOWN_PERCENT=10
MAX_OPEN_ORDERS=5
MAX_CONCURRENT_SYMBOLS=3
COOLDOWN_SECONDS=60
MAX_PRICE_DEVIATION_PERCENT=2
MIN_LIQUIDITY_USDT=0
MAX_LEVERAGE=5
MAX_MARGIN_USDT=500
MIN_LIQUIDATION_BUFFER_PERCENT=15
DEFAULT_LEVERAGE=1

BIAN_KILL_SWITCH=false
MIN_LIQUIDITY_SCORE=0.4
MAX_CROWDING=0.9
MAX_MEME_NOTIONAL_USDT=500
MAX_DIRECTIONAL_MEME_EXPOSURE_USDT=500
MIN_POSITIONING_CONFIDENCE=0.6
MIN_DATA_QUALITY=0.8
MAX_DATA_LATENCY_MS=2000
MEME_ALLOWLIST=
MEME_BLOCKLIST=
